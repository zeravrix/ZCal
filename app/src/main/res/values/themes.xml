<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <style name="Theme.ZCal" parent="android:Theme.Material.NoActionBar">
        <item name="android:windowBackground">#23212C</item>
        <item name="android:colorBackground">#23212C</item>
        <item name="android:statusBarColor">@android:color/transparent</item>
        <item name="android:navigationBarColor">@android:color/transparent</item>
        <item name="android:windowLayoutInDisplayCutoutMode" tools:targetApi="p">shortEdges</item>
    </style>

    <style name="Theme.ZCal.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">#23212C</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/splash_logo</item>
        <item name="postSplashScreenTheme">@style/Theme.ZCal</item>
    </style>
</resources>
